{
  "name": "ace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "ACE - a voice-and-text operator for Windows (see ACE_MASTER_PLAN.md).",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
