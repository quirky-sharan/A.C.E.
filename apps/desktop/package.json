{
  "name": "ace-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "ACE desktop app: Tauri shell + React UI (overlay and Control Center).",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "gen:ipc": "json2ts -i src/ipc/ipc.schema.json -o src/ipc/generated.ts --unknownAny"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
