{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACE",
  "version": "0.0.1",
  "identifier": "io.github.quirky-sharan.ace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "control-center",
        "title": "ACE Control Center",
        "width": 1100,
        "height": 720,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
